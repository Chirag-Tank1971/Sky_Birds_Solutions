# Copy to .env and fill in. Never commit real values.

# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/skybirds
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=
# Exact browser origins allowed to call the API, comma-separated, no trailing slash
# (main site, www, admin panel).
CLIENT_URL=https://www.example.com,https://example.com,https://admin.example.com

# Set to true when running behind Render, Nginx or Cloudflare, so visitor IPs and
# https are detected correctly (needed for OTP limits and testimonial video links).
TRUST_PROXY=true
NODE_ENV=production
PORT=5000

# --- SMS OTP (APITxT) ---
APITXT_AUTH_KEY=
APITXT_COUNTRY_CODE=91
# APITXT_OTP_URL=https://apitxt.com/api/sendOTP

# --- SMS OTP (MSG91) --- used instead of APITxT when MSG91_AUTH_KEY is set.
# Leave MSG91_TEMPLATE_ID empty to use MSG91's shared default template until your DLT template is approved.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# OTP Widget mode (works without DLT): set both and mobile OTPs are sent and checked by MSG91's widget
# in the browser; the API confirms the widget's token. These two values are public by design.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
# MSG91_COUNTRY_CODE=91

# --- Email OTP (Resend) --- sender must be on a domain verified in Resend
RESEND_API_KEY=
RESEND_FROM=SkyBirds <no-reply@skybirdssolution.com>
OTP_PEPPER=
OTP_EXPIRE_MINUTES=5

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when adding the webhook in the Razorpay dashboard
# (URL: https://<api-host>/api/payment/razorpay/webhook, events: order.paid,
# payment.captured, payment.authorized).
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (course thumbnails) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Video storage and playback ---
# Must be a persistent disk in production; Render's free-tier disk is wiped on restart.
VIDEO_STORAGE_PATH=./private-videos
# Playback tokens are renewed automatically by the player; 1800 is a safe value.
PLAYBACK_TOKEN_TTL_SECONDS=1800
# Upload size limit in bytes. The code caps this at 2 GB (2147483648).
MAX_VIDEO_UPLOAD_BYTES=2147483648
# FFMPEG_PRESET=veryfast
# FFMPEG_CRF=23
# Public address of this API, used for testimonial video links.
# PUBLIC_API_ORIGIN=https://api.example.com

# --- Login sessions ---
JWT_EXPIRE=7d

# --- Seeding a disposable database only (npm run seed) ---
# SEED_ALLOW_DESTRUCTIVE=true
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
